# URL of the NestJS API used by server-side auth routes.
BACKEND_API_URL=http://localhost:4000

# Google sign-in. Client ID is public; the client secret belongs only in the API env.
# This must exactly match the API value and Google Cloud's Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Public API hostname used for immutable GLB/image asset delivery.
# The frontend also falls back to this hostname automatically in production.
NEXT_PUBLIC_ASSET_BASE_URL=https://api.voxel3d.org

# Cloudflare Turnstile site key for customer login, registration, and password recovery.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFMnnPutFRovFWWn

# Customer contact links shown on the custom and contact pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello.voxel3d@gmail.com

# Canonical public origin used for metadata, robots.txt, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://voxel3d.org
