{
  "name": "3d-commerce-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed-admin": "tsx src/prisma/seeds.ts",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:release": "prisma migrate deploy && npm run db:seed-admin"
  },
  "dependencies": {
  "@fastify/multipart": "^10.1.1",
  "@nestjs/common": "12.0.3",
  "@nestjs/core": "12.0.3",
  "@nestjs/mapped-types": "12.0.0",
  "@nestjs/platform-fastify": "12.0.3",
  "@nestjs/schedule": "12.0.2",
  "@prisma/adapter-pg": "^7.10.0",
  "@prisma/client": "^7.10.0",
  "class-transformer": "^0.5.1",
  "class-validator": "^0.15.1",
  "dotenv": "^17.4.2",
  "nodemailer": "^10.0.10",
  "pg": "^8.23.0",
  "razorpay": "^2.9.6",
  "reflect-metadata": "^0.2.2",
  "rxjs": "^7.8.1",
  "sharp": "^0.35.4"
},
  "devDependencies": {
  "@eslint/eslintrc": "^3.2.0",
  "@eslint/js": "^9.18.0",
  "@nestjs/cli": "12.0.3",
  "@nestjs/testing": "12.0.3",
  "@types/express": "^5.0.0",
  "@types/jest": "^30.0.0",
  "@types/node": "^24.0.0",
  "@types/nodemailer": "^8.0.2",
  "@types/pg": "^8.23.1",
  "@types/supertest": "^7.0.0",
  "eslint": "^9.18.0",
  "eslint-config-prettier": "^10.0.1",
  "eslint-plugin-prettier": "^5.2.2",
  "prettier": "^3.4.2",
  "prisma": "^7.10.0",
  "source-map-support": "^0.5.21",
  "ts-jest": "^29.2.5",
  "ts-loader": "^9.5.2",
  "ts-node": "^10.9.2",
  "tsconfig-paths": "^4.2.0",
  "tsx": "^4.20.3",
  "typescript": "^5.9.3",
  "typescript-eslint": "^8.20.0"
},
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "js-yaml": {
      "3.15.1": "3.15.2",
      "4.3.1": "4.3.2"
    },
    "mysql2": "3.24.4"
  },
  "jest": {
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "moduleResolution": "Bundler",
          "target": "ES2023",
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true,
          "isolatedModules": true
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": [
    "<rootDir>/test-setup.ts"
  ],
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node"
}
}
