FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci

COPY tsconfig*.json nest-cli.json ./
COPY src ./src
COPY scripts ./scripts
RUN npx prisma generate && npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV PDF_TO_SVG_BIN=/usr/bin/pdftocairo
ENV BLENDER_BIN=/usr/local/bin/blender
ENV PROCESSING_WORKER_ENABLED=false
ENV CONVERSION_WORKER_ENABLED=true

RUN apt-get update && apt-get install -y --no-install-recommends openssl curl ca-certificates poppler-utils xz-utils libxi6 libxrender1 libxfixes3 libxkbcommon0 libsm6 libgl1 libegl1 libfontconfig1 libx11-6 libxext6 libxrandr2 libxinerama1 libxcursor1 libdbus-1-3 libwayland-client0 && rm -rf /var/lib/apt/lists/*

ARG BLENDER_VERSION=4.5.14
RUN curl -fsSL "https://download.blender.org/release/Blender4.5/blender-${BLENDER_VERSION}-linux-x64.tar.xz" -o /tmp/blender.tar.xz \
  && mkdir -p /opt \
  && tar -xJf /tmp/blender.tar.xz -C /opt \
  && ln -s "/opt/blender-${BLENDER_VERSION}-linux-x64/blender" /usr/local/bin/blender \
  && rm /tmp/blender.tar.xz
RUN npm install --global @gltf-transform/cli@4.5.1

COPY --from=build /app/package*.json ./
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules

RUN gltf-transform --version && blender --background --version

RUN chown -R node:node /app
USER node

CMD ["node", "dist/worker.js"]
