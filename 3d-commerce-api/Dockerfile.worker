FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci

COPY tsconfig*.json nest-cli.json ./
COPY src ./src
COPY scripts ./scripts
RUN npx prisma generate && npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV PDF_TO_SVG_BIN=/usr/bin/pdftocairo

RUN apt-get update   && apt-get install -y --no-install-recommends openssl curl ca-certificates poppler-utils   && rm -rf /var/lib/apt/lists/*
RUN npm install --global @gltf-transform/cli@4.5.1
RUN npm install --global @gltf-transform/cli@4.5.1

COPY --from=build /app/node_modules ./node_modules

COPY --from=build /app/node_modules ./node_modules

RUN chown -R node:node /app
USER node

CMD ["node", "dist/worker.js"]
