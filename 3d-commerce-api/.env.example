DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advfx
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Voxel3D Administrator
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_CAPTCHA_PROVIDER=math
AUTH_CAPTCHA_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_EXPOSE_DEV_TOKENS=false
TRUST_PROXY=false
MAX_UPLOAD_SIZE_MB=50
MAX_MODEL_MB=150
API_RATE_LIMIT_PER_MINUTE=120
# Use "s3" for Backblaze B2 and other S3-compatible providers.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# For Backblaze B2, use the region embedded in the bucket endpoint, e.g. us-east-005.
STORAGE_REGION=us-east-1
# Leave empty when objects are private and served through the API asset route.
STORAGE_PUBLIC_BASE_URL=
PROCESSING_WORKER_CONCURRENCY=1
SENTRY_DSN=
# Dedicated 3D conversion worker settings
PROCESSING_WORKER_ENABLED=false
CONVERSION_WORKER_ENABLED=false
CONVERSION_WORKER_CONCURRENCY=1
CONVERSION_WORKER_POLL_INTERVAL_MS=2000
CONVERSION_WORKER_STALE_AFTER_MS=7200000
CONVERSION_TIMEOUT_MS=300000
CONVERSION_MAX_UPLOAD_MB=250
BLENDER_BIN=/usr/local/bin/blender
