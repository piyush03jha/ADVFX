# Tune connection_limit per API replica; aggregate limits must stay below the database connection budget.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advfx?connection_limit=5&pool_timeout=10
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Voxel3D Administrator
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set to turnstile to enable Cloudflare Turnstile for login, registration, and password recovery.
AUTH_CAPTCHA_PROVIDER=math
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames allowed by the Turnstile widget (no scheme or paths).
TURNSTILE_HOSTNAMES=voxel3d.org,www.voxel3d.org,localhost
# Required for the math CAPTCHA fallback.
AUTH_CAPTCHA_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_EXPOSE_DEV_TOKENS=false
# Google OAuth web client. Never expose GOOGLE_CLIENT_SECRET to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Shared with the Next.js app; required to trust signed client-IP assertions.
INTERNAL_PROXY_SECRET=
# Deprecated; arbitrary forwarded headers are never trusted by the API listener.
TRUST_PROXY=false
MAX_UPLOAD_SIZE_MB=50
MAX_MODEL_MB=150
API_RATE_LIMIT_PER_MINUTE=120
# Enable only after applying the matching PostgreSQL migrations in this environment.
SHARED_RATE_LIMIT_ENABLED=false
DISTRIBUTED_CAPTCHA_REPLAY_ENABLED=false
PRODUCT_VIEW_DEDUPE_ENABLED=false
# Use "b2" for Backblaze B2, "s3" for generic S3-compatible storage.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Backblaze B2: STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com (no bucket in it),
# STORAGE_BUCKET=<bucket name>, STORAGE_ACCESS_KEY_ID=<B2 keyID>, STORAGE_SECRET_ACCESS_KEY=<B2 applicationKey>.
# STORAGE_REGION must equal the region inside the endpoint host, e.g. us-east-005 (NOT us-east-1).
STORAGE_REGION=us-east-005
# Leave empty when objects are private and served through the API asset route.
STORAGE_PUBLIC_BASE_URL=
PROCESSING_WORKER_CONCURRENCY=1
SENTRY_DSN=
# Dedicated 3D conversion worker settings
PROCESSING_WORKER_ENABLED=false
CONVERSION_WORKER_ENABLED=false
CONVERSION_WORKER_CONCURRENCY=1
CONVERSION_WORKER_POLL_INTERVAL_MS=2000
CONVERSION_WORKER_STALE_AFTER_MS=7200000
CONVERSION_TIMEOUT_MS=300000
CONVERSION_MAX_UPLOAD_MB=250
BLENDER_BIN=/usr/local/bin/blender
