DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advfx
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ADVFX Administrator
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGINS=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_CAPTCHA_PROVIDER=math
AUTH_CAPTCHA_SECRET=replace-with-a-random-secret-at-least-32-characters
# Production only: Cloudflare Turnstile server secret
TURNSTILE_SECRET_KEY=
AUTH_EXPOSE_DEV_TOKENS=false
TRUST_PROXY=false
MAX_UPLOAD_SIZE_MB=50
API_RATE_LIMIT_PER_MINUTE=120

# Oracle production storage: use r2 or s3. Local is development-only.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Public CDN/custom-domain URL, e.g. https://cdn.example.com
STORAGE_PUBLIC_BASE_URL=

# Optional Sentry project DSN for API error/alert reporting.
SENTRY_DSN=
